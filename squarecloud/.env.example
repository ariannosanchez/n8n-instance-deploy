# ===== Red (obligatorio en Square Cloud) =====
N8N_HOST=0.0.0.0
N8N_PORT=80
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
# Mismo SUBDOMAIN que en squarecloud.app
WEBHOOK_URL=https://n8n-cliente-a.squareweb.app/
N8N_EDITOR_BASE_URL=https://n8n-cliente-a.squareweb.app

# ===== Seguridad =====
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Para MIGRAR un cliente desde Railway: usar la clave de su /home/node/.n8n/config
N8N_ENCRYPTION_KEY=CAMBIAR
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# ===== Base de datos: Postgres gestionado de Square Cloud (crearlo en Dashboard > Databases) =====
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=CAMBIAR
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=CAMBIAR
DB_POSTGRESDB_USER=CAMBIAR
DB_POSTGRESDB_PASSWORD=CAMBIAR
# Square Cloud solo acepta conexiones SSL
DB_POSTGRESDB_SSL_ENABLED=true
# El certificado es autofirmado por Square Cloud: o se desactiva la verificacion (abajo) o se sube su .pem
# y se apunta con DB_POSTGRESDB_SSL_CA_FILE=/ruta/ca.pem
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_POOL_SIZE=2

# ===== Mismas optimizaciones que el template de Railway =====
NODE_OPTIONS=--max-old-space-size=384
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=2000
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
